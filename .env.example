# Copy this file to .env and fill in real values. Never commit .env itself.

# Used in the Crossref "polite pool" mailto param and NCBI E-utilities requests.
# Using a real contact email gets you better rate limits and fewer blocks.
CONTACT_EMAIL=you@example.com

# OpenAI API key for the claim-vs-source comparison call (step 4).
OPENAI_API_KEY=sk-...

# Optional: OpenAI model for the comparison call. Defaults to gpt-4o-mini.
# Point production at a stronger model (e.g. gpt-4o) without editing code.
OPENAI_MODEL=gpt-4o-mini

# Optional: fixed seed for the primary (temperature=0) comparison call, for
# best-effort determinism across repeated runs on the same input. Not a
# hard guarantee (OpenAI documents seed as "mostly" deterministic), but
# sharply reduces run-to-run verdict flips on borderline citations.
LLM_SEED=42

# Optional: NCBI API key. Not required, but raises E-utilities rate limits
# from 3 req/sec to 10 req/sec if you have one.
NCBI_API_KEY=

# Optional: shared secret for the webapp API. When set, /api/analyze,
# /api/analyze-text, and /api/recheck require a matching X-API-Key header.
# Leave unset for local dev. If you set this in a shared deployment, the
# frontend also needs to send this header on those requests -- it doesn't
# yet, so coordinate that change before turning this on in production.
API_KEY=

# Optional: per-IP rate limits on the endpoints that trigger real
# Crossref/NCBI/OpenAI calls. Defaults shown; override if needed.
RATE_LIMIT_ANALYZE=10 per hour
RATE_LIMIT_RECHECK=30 per hour

# Optional: how long a finished/running analyze-text job stays in memory
# before it's purged. Defaults to 1 hour (3600 seconds).
JOB_TTL_SECONDS=3600

# Run mode. Enable at most one: live calls the real models (paid); simulation returns canned results.
REFCHECK_LIVE_JUDGE=0
REFCHECK_ALLOW_OFFLINE_SIMULATION=0

# Where job results, judge logs and saved model calls are kept. Point this at a persistent disk in
# production; the default (./output) is wiped whenever a free Render instance restarts.
# REFCHECK_DATA_DIR=/var/data/refcheck

# Optional: stop after this many NEW model calls in one server process (saved calls replay free).
# REFCHECK_MAX_MODEL_CALLS=30
