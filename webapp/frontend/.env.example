# Leave this unset for local development -- Vite's dev server proxies
# /api requests to http://localhost:5000 automatically (see vite.config.js).
#
# For production (e.g. after deploying the frontend to Vercel), set this
# to your deployed backend's URL, e.g.:
# VITE_API_URL=https://citation-checker-api.onrender.com
VITE_API_URL=

# Only needed if the backend has API_KEY set (see backend .env.example).
# Must match the backend's value exactly. Leave both unset together for an
# open deployment.
VITE_API_KEY=
